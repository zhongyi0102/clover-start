# 编译产物
app/CloverStart.exe
app/*.pdb
app/*.log

# 运行日志
*.log

# 用户数据（每个人的应用清单、设置、使用记录都不同）
config/
desktop-backup/

# 发布包（由 tools\make-release.ps1 生成）
dist/

# 测试产物
tests/bin/
tests/*.exe

# 由 build.ps1 自动生成（版本号 + 构建时间戳），不入库。
# build.ps1 每次编译都会无条件重写它，提交它只会让 git status 永远不干净。
# 代价：clone 后必须先跑一次 build.ps1 才能编译（README 已说明）。
src/core/Version.cs

# 编辑器与系统
.vs/
*.user
*.suo
Thumbs.db
.DS_Store
