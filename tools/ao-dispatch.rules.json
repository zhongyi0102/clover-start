{
  "$schema": "ao-dispatch rules v1",
  "_comment": "AO 任务分配规则。改这个文件即可调整分配，不用改代码。",
  "_docs": {
    "agent": "目标 agent。可用：deepseek-harness / codex（agy、mimo-code 已禁用）",
    "needsWrite": "是否要改文件。codex 不尊重 worktree，needsWrite=true 的任务会被拒绝派给 codex",
    "model": "模型档位。cheap = x0.11，normal = x0.17（仅 deepseek-harness 有效）",
    "priority": "数字越小越优先。同一任务命中多条规则时取 priority 最小的"
  },

  "agents": {
    "deepseek-harness": {
      "enabled": true,
      "label": "DeepSeek Harness",
      "respectsWorktree": true,
      "costTier": 1,
      "models": {
        "cheap": "[\"jethub\",\"workbuddy/deepseek-v4.1-flash-sg\"]",
        "normal": "[\"jethub\",\"buddy/deepseek-v4-flash\"]"
      },
      "notes": "主力。尊重 worktree，走腾讯积分。所有写文件任务都由它做。"
    },
    "codex": {
      "enabled": true,
      "label": "Codex",
      "respectsWorktree": false,
      "costTier": 3,
      "models": {
        "normal": "[\"magpie-responses\",\"agentrouter-plugin/gpt-5.6-sol\"]"
      },
      "notes": "只用于只读的困难任务（强推理）。写文件任务一律排除。"
    },
    "agy": {
      "enabled": false,
      "label": "Agy (Antigravity)",
      "respectsWorktree": true,
      "costTier": 2,
      "models": {},
      "notes": "暂不启用。"
    },
    "mimo-code": {
      "enabled": false,
      "label": "MiMo Code",
      "respectsWorktree": true,
      "costTier": 2,
      "models": {},
      "notes": "暂不启用。"
    }
  },

  "limits": {
    "maxActiveSessions": 3,
    "maxPerAgent": 2,
    "maxOrchestrators": 1,
    "keepLastTerminated": 3
  },

  "rules": [
    {
      "id": "image",
      "label": "带图片",
      "priority": 10,
      "target": "codex",
      "needsWrite": false,
      "reason": "带图片 → Codex（DSH 当前配置不支持图片输入）",
      "keywords": [
        "图片", "截图", "照片", "图像", "设计稿", "原型图",
        "这张图", "看图", "图上", "图里", "图片里", "ui图", "ui 图"
      ],
      "extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg"],
      "pathPatterns": ["images/", "image/", "img/", "pics/", "screenshots/"]
    },
    {
      "id": "hard",
      "label": "困难任务",
      "priority": 20,
      "target": "codex",
      "needsWrite": false,
      "reason": "困难任务 → Codex（强推理）",
      "keywords": [
        "架构", "设计模式", "根因", "根本原因", "性能调优", "性能优化",
        "算法", "并发", "死锁", "竞态", "内存泄漏", "系统性",
        "整体重构", "整个项目", "全局", "所有文件",
        "方案对比", "选型", "利弊", "权衡", "最佳实践",
        "审查", "review", "评审", "深度分析", "复杂", "难点",
        "为什么", "定位", "根因分析"
      ]
    },
    {
      "id": "review",
      "label": "代码审查",
      "priority": 30,
      "target": "codex",
      "needsWrite": false,
      "model": "normal",
      "reason": "审查 → Codex（强推理，只读安全）",
      "keywords": ["审查", "review", "评审", "检查代码", "评估质量", "找问题"]
    },
    {
      "id": "investigate",
      "label": "调查/分析",
      "priority": 40,
      "target": "deepseek-harness",
      "needsWrite": false,
      "model": "cheap",
      "reason": "调查 → DSH（便宜，只读）",
      "keywords": ["分析", "调查", "研究", "怎么会", "找出原因", "解释"]
    },
    {
      "id": "docs",
      "label": "文档",
      "priority": 50,
      "target": "deepseek-harness",
      "needsWrite": true,
      "model": "cheap",
      "reason": "文档 → DSH（便宜，写文件安全）",
      "keywords": ["文档", "README", "CHANGELOG", "注释", "说明", "写清楚", "整理成"]
    },
    {
      "id": "test",
      "label": "测试",
      "priority": 60,
      "target": "deepseek-harness",
      "needsWrite": true,
      "model": "normal",
      "reason": "测试 → DSH",
      "keywords": ["测试", "test", "单元测试", "用例", "覆盖率", "断言"]
    },
    {
      "id": "refactor",
      "label": "重构",
      "priority": 70,
      "target": "deepseek-harness",
      "needsWrite": true,
      "model": "normal",
      "reason": "重构 → DSH（写文件安全）",
      "keywords": ["重构", "重写", "拆分", "合并", "抽取", "优化结构", "清理"]
    },
    {
      "id": "code",
      "label": "写代码/修 bug",
      "priority": 80,
      "target": "deepseek-harness",
      "needsWrite": true,
      "model": "normal",
      "reason": "写代码 → DSH（写文件安全）",
      "keywords": ["修复", "修", "实现", "添加", "新增", "改", "写一个", "开发", "bug", "报错", "错误"]
    }
  ],

  "default": {
    "id": "default",
    "label": "通用任务",
    "target": "deepseek-harness",
    "needsWrite": true,
    "model": "normal",
    "reason": "未命中任何规则 → DSH（保守选择：能写文件、便宜）"
  },

  "semantic": {
    "_comment": "D 层：关键词没命中或置信度低时，用 Semantic Router 做语义兜底",
    "enabled": true,
    "endpoint": "http://127.0.0.1:8765/route",
    "timeoutMs": 2000,
    "threshold": 0.6,
    "fallbackOnError": true
  }
}
